# Источник данных: sample — образец в lib/; vendure — каталог и корзина из Vendure Shop API
# (содержание — образец); live — Vendure + Payload (план 4)
SOURCE=sample
SITE_URL=http://localhost:3020
VENDURE_SHOP_API_URL=
VENDURE_CHANNEL_TOKEN=
# Язык, которым спрашивать движок, когда языка страницы у канала нет (у cbdin — bg и en)
VENDURE_FALLBACK_LANG=en
# on — ставить заказы в движке. Пусто — оформление доходит до оплаты и говорит «заказы выключены»:
# витрина, подключённая к действующему магазину для показа, настоящих заказов в нём не ставит
VENDURE_PLACE_ORDERS=
# Вход через Google и Facebook (И787) здесь не настраивается: ключи и секреты — у сервера Vendure
# (плагин набора skills/site-building/assets/vendure/plugins/social-auth, README там же). Витрина
# рисует кнопку только того поставщика, которого называет сервер (socialSignInProviders), — без
# плагина кнопок нет. Адреса возврата для консолей Google и Meta: <SITE_URL>/api/auth/google/callback
# и <SITE_URL>/api/auth/facebook/callback — поэтому SITE_URL должен быть адресом сайта (https).
# on — образец (SOURCE=sample) показывает кнопки Google и Facebook и входит подставным лицом без окна
# поставщика: только для разработки и проверок. Пусто — у образца кнопок нет (на сайте без сервера — пустышка)
SAMPLE_SOCIAL=
PAYLOAD_URL=
# Секрет POST /api/revalidate (заголовок x-revalidate-secret): админка сбрасывает кэш вида по тегу look
REVALIDATE_SECRET=
PREVIEW_SECRET=
# look-panel: панель вида (look-panel/, PANEL.md) — заказчик выбирает цвет, шрифт, ритм, кнопки и шапку
# look-panel: на самой витрине; on — пока идёт выбор. Снять совсем: npm run look:remove
LOOK_PICKER=
